# Backend API (Spring Boot includes the /api context path).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Microsoft Entra ID — frontend SPA app registration.
# Get TENANT_ID from Entra ID > Overview > Directory (tenant) ID.
# Get CLIENT_ID from the frontend app registration's Overview page.
NEXT_PUBLIC_AZURE_AD_TENANT_ID=503085e6-8bb7-44c4-86bf-319a33b22534
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=

# Must exactly match a Redirect URI configured under the SPA app registration.
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=https://dt-outage.vercel.app/login

# This is the API app registration's Application ID URI plus its exposed scope.
# Example: api://<backend-api-client-id>/access_as_user
NEXT_PUBLIC_AZURE_AD_API_SCOPE=api://fb397327-201c-4133-80e5-2ddd58af33d9/access_as_user
NEXT_PUBLIC_ENTRA_PASSWORD_RESET_URL=https://passwordreset.microsoftonline.com/

# Render frontend example:
# NEXT_PUBLIC_API_BASE_URL=https://<backend-service>.onrender.com/api
# NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=https://<frontend-service>.onrender.com/login
