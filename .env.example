# Base URL of the Spring Boot backend (includes the /api context path).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Entra ID (Azure AD) app registration — used once NextAuth (or an
# equivalent) is wired up for the SSO login flow.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
